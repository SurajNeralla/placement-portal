# PlacementHub Backend – Environment Configuration
# Copy this file to .env and fill in your values

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Leave as default to use in-memory mock (development)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=placementhub

# ─── JWT Security ─────────────────────────────────────────────────────────────
# CHANGE THIS in production to a long random secret
JWT_SECRET=supersecretjwtkey_change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ─── SMTP Email (Optional) ────────────────────────────────────────────────────
# If not set, OTPs are printed to the terminal console only.
# For Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_FROM_NAME=PlacementHub

# ─── Professional Account Verification (OAuth) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# GitHub OAuth App:
# 1. Create at https://github.com/settings/developers -> New OAuth App
# 2. Authorization callback URL: http://127.0.0.1:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback

# LinkedIn OAuth App:
# 1. Create at https://www.linkedin.com/developers/apps -> Create App
# 2. Enable "Sign In with LinkedIn using OpenID Connect" (Scopes: openid, profile, email)
# 3. Authorized redirect URL: http://127.0.0.1:8000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/auth/linkedin/callback

